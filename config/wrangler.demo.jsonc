{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "cfb2-pan-demo",
  "main": "../src/index.ts",
  "compatibility_date": "2026-06-01",
  "workers_dev": false,
  "preview_urls": false,
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  "assets": { "directory": "../public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "vars": { "APP_MODE": "demo" },
  "d1_databases": [
    { "binding": "DB", "database_name": "cfb2-pan-demo", "database_id": "cfb2-pan-demo", "migrations_dir": "../migrations" }
  ],
  "r2_buckets": [{ "binding": "DEMO_STORE", "bucket_name": "cfb2-pan-demo" }],
  "triggers": { "crons": ["*/15 * * * *"] }
}
